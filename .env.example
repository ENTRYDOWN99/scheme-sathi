# ==============================================================================
# Scheme Saathi - Root Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development. Never commit .env!
# Leave values empty in this template; set local/production values in .env only.

# --- Backend Server ---
PORT=
NODE_ENV=
LOG_LEVEL=
CORS_ORIGIN=

# Database (e.g. sqlite:./data/saathi.db for dev, or postgresql://... in prod)
DATABASE_URL=

# JWT Secrets (>= 32 random chars in production)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# AES-256-GCM PII Encryption Key (64 hex chars = 32 bytes in production)
PII_ENCRYPTION_KEY=

# Gemini AI Provider (optional; deterministic fallback runs if blank)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_MS=

# --- Web Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=

# --- Android Build & Signing ---
API_BASE_URL=
KEYSTORE_PATH=
STORE_PASSWORD=
KEY_PASSWORD=
