# ==============================================================================
# Scheme Saathi - Build & Signing Environment Variables
# ==============================================================================
#
# Optional environment variables used by app/build.gradle.kts for release APK signing:
# (Debug builds automatically fall back to standard Android debug keystores).

# Path to custom release keystore (defaults to ${rootDir}/my-upload-key.jks if not set)
KEYSTORE_PATH=/path/to/your/release.keystore

# Release keystore store password
STORE_PASSWORD=your_keystore_password_here

# Release key alias password
KEY_PASSWORD=your_key_password_here
