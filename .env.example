# ==============================================================================
# Scheme Saathi - Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development. Never commit .env!

# --- Backend Server ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Database: leave empty or use sqlite:./data/saathi.db for local SQLite,
# or provide a PostgreSQL connection URL for Docker/production:
# DATABASE_URL=postgresql://saathi:saathi_dev_pass@localhost:5432/saathi
DATABASE_URL=sqlite:./data/saathi.db

# JWT Secrets (MUST be strong random strings >= 32 chars in production)
JWT_SECRET=dev-only-change-me-jwt-access-secret-key-32-chars
JWT_REFRESH_SECRET=dev-only-change-me-jwt-refresh-secret-key-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM PII Encryption Key (64 hex chars = 32 bytes)
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Gemini AI Provider (optional locally — falls back cleanly to deterministic summary if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite
GEMINI_TIMEOUT_MS=15000

# --- Web Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=Scheme Saathi

# --- Android Build & Signing ---
# Backend base URL injected into Android BuildConfig (10.0.2.2 reaches host localhost from Android emulator)
API_BASE_URL=http://10.0.2.2:4000/api/v1

# Optional release APK signing environment variables:
KEYSTORE_PATH=/path/to/your/release.keystore
STORE_PASSWORD=your_keystore_password_here
KEY_PASSWORD=your_key_password_here
