# ==============================================================================
# Scheme Saathi Backend - Environment Variables Template
# ==============================================================================
# Copy to backend/.env for local development. Never commit .env!

PORT=
NODE_ENV=
LOG_LEVEL=
CORS_ORIGIN=
DATABASE_URL=

# Required >= 32 random chars in production:
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Required 64 hex chars (32 bytes) in production:
PII_ENCRYPTION_KEY=

# Optional Gemini server key & tuning:
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_MS=

