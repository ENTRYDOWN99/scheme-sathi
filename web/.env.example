# ==============================================================================
# Scheme Saathi Web PWA - Environment Variables Template
# ==============================================================================
# Copy to web/.env.local for local development. Never commit .env*!
#
# Keeping NEXT_PUBLIC_API_URL=/api/v1 routes browser API calls through Next.js
# same-origin rewrites (web/next.config.ts -> BACKEND_URL) so httpOnly
# SameSite=Lax auth cookies work seamlessly across Netlify and Render.

NEXT_PUBLIC_API_URL=/api/v1
BACKEND_URL=
NEXT_PUBLIC_APP_NAME=
